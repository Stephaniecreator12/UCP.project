# ============================================================
# UCP - Exemple de configuration (.env.example)
#
# Le projet utilise DEUX fichiers .env :
#   1. backend_PPM/.env      -> config backend Django (backend_PPM/config/settings.py)
#   2. ucp-frontend/.env     -> config frontend Next.js (lu par Next.js)
#
# Copie :
#   cp .env.example backend_PPM/.env      (section BACKEND)
#   cp .env.example ucp-frontend/.env     (section FRONTEND)
#
# Regle simple :
# - en local, vous pouvez garder beaucoup de valeurs par defaut
# - adaptez surtout la base de donnees si votre machine est differente
# - en production, changez SECRET_KEY et mettez DEBUG=False
# ============================================================

# ---------- BACKEND (backend_PPM/.env) ----------

# Mode developpement local
DEBUG=True
# Cle secrete Django
# En local: vous pouvez laisser une valeur de test
# En production: mettez une vraie cle secrete unique
SECRET_KEY=change-me-for-production
# Hotes autorises
# En local: localhost et 127.0.0.1 suffisent
ALLOWED_HOSTS=127.0.0.1,localhost

# Configuration PostgreSQL locale
# Modifiez ces valeurs si votre Postgres a un autre nom de base,
# un autre utilisateur ou un autre mot de passe
DB_ENGINE=django.db.backends.postgresql
DB_NAME=passation_db
DB_USER=postgres
DB_PASSWORD=passation
DB_HOST=localhost
DB_PORT=5432

# Redis (celery) : docker compose up -d redis
CELERY_BROKER_URL=redis://localhost:6379/0

# URLs locales frontend/backend
# En general vous pouvez laisser ces valeurs en developpement
# Si vous testez depuis un telephone, indiquez l'IP locale du PC dans FRONTEND_APP_URL.
FRONTEND_APP_URL=http://localhost:3000

# CORS/CSRF pour le developpement local
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Emails
# 1. Developpement simple: EMAIL_BACKEND console -> emails affiches dans le terminal.
# 2. Envoi reel: EMAIL_BACKEND smtp puis renseignez EMAIL_HOST/PORT/USER/PASSWORD/TLS.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
# Adresse expediteur par defaut pour les emails metier de l'application
DEFAULT_FROM_EMAIL=noreply@ucp.local
# Adresse utilisee par Django pour certains emails systeme/serveur
# En local, vous pouvez laisser la meme valeur
SERVER_EMAIL=noreply@ucp.local

# Notifications metier
ACHATS_NOTIFICATION_EMAILS_ENABLED=True
ACHATS_EMAIL_SUBJECT_PREFIX='[UCP Achats] '
TDRST_NOTIFICATION_EMAILS_ENABLED=True
TDRST_EMAIL_SUBJECT_PREFIX='[UCP TDR/ST] '
OUVERTURE_NOTIFICATION_EMAILS_ENABLED=True
OUVERTURE_NOTIFICATION_CC=
OUVERTURE_EMAIL_SUBJECT_PREFIX='[UCP Ouverture] '
EVALUATION_NOTIFICATION_EMAILS_ENABLED=True
EVALUATION_EMAIL_SUBJECT_PREFIX='[UCP Évaluation] '

# ---------- FRONTEND (ucp-frontend/.env) ----------

# URL de l'API Django (utilisee par les services frontend)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# URL de l'API RH externe
NEXT_PUBLIC_API_RH_URL=https://ucp-rh-b5js.onrender.com

# URL du backend utilisee par les route handlers serveur (proxy /api/...)
BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# Secret pour les cookies (reserve a un usage futur)
NEXT_PUBLIC_COOKIE_SECRET=change-me
