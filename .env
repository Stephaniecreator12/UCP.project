
DEBUG=True
# Cle secrete Django
# En local: vous pouvez laisser une valeur de test
# En production: mettez une vraie cle secrete unique
SECRET_KEY=change-me-for-production
# Hotes autorises
# En local: localhost et 127.0.0.1 suffisent
ALLOWED_HOSTS=127.0.0.1,localhost

# Configuration PostgreSQL locale
# un autre utilisateur ou un autre mot de passe
DB_ENGINE=django.db.backends.postgresql
DB_NAME=passation_db
DB_USER=postgres
DB_PASSWORD=passation
DB_HOST=localhost
DB_PORT=5432

# URLs locales frontend/backend
# En general vous pouvez laisser ces valeurs en developpement
# Si vous testez depuis un telephone, indiquez l'IP locale du PC dans FRONTEND_LAN_HOST
# ou mettez directement FRONTEND_APP_URL=http://192.168.x.x:3000.
FRONTEND_APP_URL=http://localhost:3000
FRONTEND_LAN_HOST=
BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# CORS/CSRF pour le developpement local
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Emails
# Ce bloc a 2 usages possibles:
# 1. Developpement simple:
#    laissez EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
#    et les emails s'afficheront dans le terminal au lieu d'etre envoyes.
# 2. Envoi reel:
#    remplacez EMAIL_BACKEND par django.core.mail.backends.smtp.EmailBackend
#    puis renseignez EMAIL_HOST, EMAIL_PORT, EMAIL_HOST_USER,
#    EMAIL_HOST_PASSWORD et EMAIL_USE_TLS/SSL.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
MAIL_PROVIDER=gmail
# Mode SMTP classique Gmail
# Si Gmail bloque encore l'envoi, utilisez un mot de passe d'application Gmail au lieu du mot de passe normal.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=stephaniehanitriniala4@gmail.com
EMAIL_HOST_PASSWORD=oslbvwdzumvfiptg
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=30
# Adresse expediteur par defaut pour les emails metier de l'application
DEFAULT_FROM_EMAIL=stephaniehanitriniala4@gmail.com
# Adresse utilisee par Django pour certains emails systeme/serveur
# En local, vous pouvez laisser la meme valeur
SERVER_EMAIL=noreply@ucp.local

# Notifications metier
ACHATS_NOTIFICATION_EMAILS_ENABLED=True
ACHATS_EMAIL_SUBJECT_PREFIX='[UCP Achats] '
TDRST_NOTIFICATION_EMAILS_ENABLED=True
TDRST_EMAIL_SUBJECT_PREFIX='[UCP TDR/ST] '
OUVERTURE_NOTIFICATION_EMAILS_ENABLED=True
OUVERTURE_NOTIFICATION_CC=stephaniehanitriniala4@gmail.com
OUVERTURE_EMAIL_SUBJECT_PREFIX='[UCP Ouverture] '
EVALUATION_NOTIFICATION_EMAILS_ENABLED=True
EVALUATION_EMAIL_SUBJECT_PREFIX='[UCP Évaluation] '

# API externe optionnelle
# Laissez vide si vous n'utilisez pas l'integration personnel externe
EXTERNAL_PERSONNEL_API_URL=
EXTERNAL_PERSONNEL_API_TOKEN=
EXTERNAL_PERSONNEL_API_AUTH_HEADER=Authorization
EXTERNAL_PERSONNEL_API_AUTH_SCHEME=Bearer
EXTERNAL_PERSONNEL_API_TIMEOUT=15
